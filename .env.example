# ============================================
# UAH Archive Chatbot — Environment Variables
# ============================================

# --- AI & Search ---
GEMINI_API_KEY=your-gemini-api-key-here
# Opcional, si usas Redis para caché de embeddings:
REDIS_URL=redis://redis:6379/0
# ChromaDB para vectores locales
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- AtoM Integration ---
ATOM_BASE_URL=http://localhost:8081
ATOM_CACHE_TTL_SECONDS=3600

# --- Microservicios ---
GATEWAY_PORT=8010
CHAT_SERVICE_URL=http://chat-service:3001
SEARCH_SERVICE_URL=http://search-service:3002
ATOM_SERVICE_URL=http://atom-integration:3003
